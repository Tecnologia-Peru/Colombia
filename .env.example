# Public SPA configuration; never place passwords, tokens or client secrets here.
# Copy to .env.local, complete these values and restart Vite.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
VITE_KEYCLOAK_ADMIN_ROLE=admin
# Optional Keycloak identity-provider alias; set to google after configuring brokering.
VITE_KEYCLOAK_GOOGLE_IDP=
